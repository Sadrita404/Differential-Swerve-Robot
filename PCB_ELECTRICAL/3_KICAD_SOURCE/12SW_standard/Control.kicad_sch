	(text "EN header: center=EN_BUS, pin1=GND (jumper 1-2 = always enabled),\npin3=EN_MCU breakout for MCU-driven global enable (external jumper to center)."
		(at 88.9 60.96 0)
		(effects (font (size 1.5 1.5)))
		(uuid "4fe7dc38-d529-4926-8acc-b5b4b7fdf3d8")
	)
	(text "IDC pin map (interleaved per channel): odd pins 1,3..23=STEP1-12, even pins 2,4..24=DIR1-12, 25=GND, 26=VDD (5V sense/supply). Each channel's STEP/DIR pair shares one connector column and adjacent ribbon wires."
		(at 88.9 165.1 0)
		(effects (font (size 1.5 1.5)))
		(uuid "8fe1a408-64a3-4afb-9e3d-d8b69a9226f7")
